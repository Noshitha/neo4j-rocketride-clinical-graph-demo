    {
      "id": "db_neo4j_1",
      "provider": "db_neo4j",
      "config": {
        "profile": "default",
        "default": {
          "db_description": "Synthetic diabetes and chronic kidney disease clinical graph. Patient nodes are connected to ConditionProfile, LabSnapshot, Medication, RiskMarker, Contraindication, FollowUpEvent, TrendFlag, and Recommendation nodes. Use patient_id values such as P001, P002, P003, and P004.",
          "uri": "${ROCKETRIDE_NEO4J_URI}",
          "auth_method": "userpass",
          "user": "${ROCKETRIDE_NEO4J_USERNAME}",
          "password": "${ROCKETRIDE_NEO4J_PASSWORD}",
          "database": "neo4j",
          "max_attempts": 5
        }
      },
      "ui": {
        "position": {
          "x": -320.5144310003504,
          "y": -270.8222711553349
        },
        "measured": {
          "width": 150,
          "height": 121
        },
        "nodeType": "default",
